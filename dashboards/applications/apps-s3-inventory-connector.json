{
  "id": null,
  "uid": "s3-parquet-processing",
  "title": "S3 Parquet Inventory Connector (All Clusters)",
  "tags": [
    "s3",
    "parquet",
    "nats",
    "metrics",
    "git-sync"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "🟢 Live Data — HTTP Self-Telemetry (confirmed working via kubectl exec .../metrics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "HTTP Request Rate by Route",
      "description": "Real data from this pod today. Only /health and /metrics routes exist right now - this is the connector being scraped/probed, not business traffic.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "HTTP Request Duration p95 by Route",
      "description": "Real data from this pod today.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
