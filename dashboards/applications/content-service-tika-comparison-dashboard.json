{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "A/B comparison of Tika and Kreuzberg text extractors. Surfaces success-rate delta, latency comparison, and per-extension breakdown of dual-run telemetry from content-service when EXTRACTION_COMPARISON_ENABLED=true.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 9000,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**All panels below require `EXTRACTION_COMPARISON_ENABLED=true` on content-service — confirmed via kubectl exec into applications-content-service (Integration, 2026-08-20) that it is explicitly set to `false`, with `EXTRACTION_COMPARISON_SAMPLE_RATE=0` as well. This is a deliberate config choice (dual-running Tika + Kreuzberg on every file doubles extraction cost), not a bug** — the `$job`/`$namespace` picker resolves correctly, the queries are correct, there is simply no dual-run telemetry being produced right now. This dashboard will populate automatically once the flag is turned on for a real A/B comparison window. That's a deployment config change (env var on the content-service container), not something fixable from this dashboards repo."
      },
      "transparent": false
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 100,
      "panels": [],
      "title": "Comparison overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total dual-run comparisons in the selected time range. Each increment represents one file processed by both parsers.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(content_extraction_comparison_total{namespace=\"$namespace\", job=\"$job\"}[$__range]))",
          "legendFormat": "total comparisons",
          "refId": "A"
        }
      ],
      "title": "Total dual-run comparisons",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Number of dual-runs where both parsers succeeded and Tika was faster. High value = Tika wins A/B test on speed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(content_extraction_comparison_total{outcome=\"both_ok\", faster=\"tika\", namespace=\"$namespace\", job=\"$job\"}[$__range]))",
          "legendFormat": "tika wins",
          "refId": "A"
        }
      ],
      "title": "Tika wins (faster on both_ok)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Kreuzberg failed but Tika succeeded — the most operationally meaningful signal. High value = Tika is more reliable than Kreuzberg on the current workload.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(content_extraction_comparison_total{outcome=\"tika_ok_kreuzberg_fail\", namespace=\"$namespace\", job=\"$job\"}[$__range]))",
          "legendFormat": "tika rescues",
          "refId": "A"
        }
      ],
      "title": "Kreuzberg-fail / Tika-ok rescues",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 200,
      "panels": [],
      "title": "Per-parser success rate",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Success rate over time per parser. A persistent gap between kreuzberg and tika indicates a reliability difference. Values below 1.0 warrant investigation of the failure-modes row.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(content_extraction_total{parser_kind=\"kreuzberg\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])) / sum(rate(content_extraction_total{parser_kind=\"kreuzberg\", namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "kreuzberg",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(content_extraction_total{parser_kind=\"tika\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])) / sum(rate(content_extraction_total{parser_kind=\"tika\", namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "tika",
          "refId": "B"
        }
      ],
      "title": "Success rate over time (per parser)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current success rate per parser (last non-null sample). Green ≥ 0.95, yellow ≥ 0.80, red below.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(content_extraction_total{parser_kind=\"kreuzberg\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])) / sum(rate(content_extraction_total{parser_kind=\"kreuzberg\", namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "kreuzberg",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(content_extraction_total{parser_kind=\"tika\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])) / sum(rate(content_extraction_total{parser_kind=\"tika\", namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "tika",
          "refId": "B"
        }
      ],
      "title": "Current success rate (per parser)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 300,
      "panels": [],
      "title": "Outcome breakdown",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Distribution of comparison outcomes over the selected time range. both_ok = happy path; kreuzberg_ok_tika_fail / tika_ok_kreuzberg_fail indicate asymmetric reliability; both_fail_* indicate correlated failures.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 23
      },
      "id": 6,
      "options": {
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "pieType": "donut",
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (increase(content_extraction_comparison_total{namespace=\"$namespace\", job=\"$job\"}[$__range]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Outcome distribution (time range total)",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Comparison outcome counts by extension. Sort by a column to find file types driving failures or rescues.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 23
      },
      "id": 7,
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome, extension) (increase(content_extraction_comparison_total{namespace=\"$namespace\", job=\"$job\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Outcome × extension breakdown",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "namespace": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 400,
      "panels": [],
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per-parser extraction latency for successful extractions. p50/p95/p99 for each parser — 6 series total. Sustained Kreuzberg p99 above Tika p99 is the clearest speed-advantage signal.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(content_extraction_duration_seconds_bucket{parser_kind=\"kreuzberg\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "kreuzberg p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(content_extraction_duration_seconds_bucket{parser_kind=\"kreuzberg\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "kreuzberg p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(content_extraction_duration_seconds_bucket{parser_kind=\"kreuzberg\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "kreuzberg p99",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(content_extraction_duration_seconds_bucket{parser_kind=\"tika\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "tika p50",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(content_extraction_duration_seconds_bucket{parser_kind=\"tika\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "tika p95",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(content_extraction_duration_seconds_bucket{parser_kind=\"tika\", status=\"success\", namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "tika p99",
          "refId": "F"
        }
      ],
      "title": "Extraction latency p50/p95/p99 (success, per parser)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Signed latency difference (Tika − Kreuzberg) in seconds. Negative = Tika is faster. The zero line is the Tika-faster / Tika-slower divider. p50 shows the typical case; p95 shows the tail.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "zero line"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(content_extraction_comparison_latency_diff_seconds_bucket{namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "p50 diff (tika − kreuzberg)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(content_extraction_comparison_latency_diff_seconds_bucket{namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "p95 diff (tika − kreuzberg)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "0 * sum(rate(content_extraction_comparison_total{namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "zero line",
          "refId": "C"
        }
      ],
      "title": "Comparison latency diff p50/p95 (Tika − Kreuzberg, signed)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "id": 500,
      "panels": [],
      "title": "Per-extension breakdown",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per-extension success rate and throughput for each parser. Use transformations to compare kreuzberg vs tika side-by-side per extension.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*count.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "id": 10,
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "extension"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (extension, parser_kind) (increase(content_extraction_total{status=\"success\", namespace=\"$namespace\", job=\"$job\"}[$__range])) / sum by (extension, parser_kind) (increase(content_extraction_total{namespace=\"$namespace\", job=\"$job\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Success rate by extension × parser",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "namespace": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "success_rate"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Rate of Tika-rescued comparisons (kreuzberg failed, tika succeeded) broken down by extension over time. Extensions with consistently high rescue rates are where Kreuzberg has the most coverage gaps.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (extension) (rate(content_extraction_comparison_total{outcome=\"tika_ok_kreuzberg_fail\", namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "{{extension}}",
          "refId": "A"
        }
