{
  "uid": "apps-v2-datasource-service-overview",
  "title": "Datasource Service — Overview",
  "description": "Job definitions, their schedules, the firings those schedules produce, and the Connect API the UI calls. The service instruments four things: whether the API is mounted, whether a token can be verified, what happened to each firing, and the shared HTTP set over the Connect handlers. It serves Connect over HTTP rather than gRPC, so its RPCs are counted as HTTP requests and there are no grpc_* series. Job progress belongs to the job engine and the run history is in Postgres; this board answers only what is true about this pod.",
  "folderUid": "apps-v2-datasource-service-folder",
  "tags": [
    "git-sync",
    "apps-v2",
    "service:datasource-service",
    "overview"
  ],
  "timezone": "utc",
  "editable": null,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Datasource Service — Runtime",
      "type": "link",
      "url": "/d/apps-v2-datasource-service-runtime?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus-nx"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*datasource-service.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "description": "Applies only to the per-pod panels at the bottom. Aggregate panels ignore it so pod churn does not gap the graphs.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\".*datasource-service.*\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Service Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Pods Up",
      "description": "The UI reaches this service over Connect for everything to do with job definitions, and its schedules fire from the same process. A pod that is down means no scan can be defined, edited or started, and no cron schedule fires for as long as it stays down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*datasource-service.*\", namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API Enabled",
      "description": "1 when this process mounts the Connect API, 0 when it runs the scheduler only. This is the panel that catches a mistyped JWKS_URL: an unset or unusable value turns the API off rather than stopping the process, so the pod starts, passes both probes, keeps firing its schedules, and answers every RPC the UI makes with a 404. Nothing else in the stack reports that — 0 here on a pod meant to serve the UI is the alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(api_enabled{job=~\".*datasource-service.*\", namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "JWKS Available",
      "description": "1 while the JWT authority key set has usable keys. The key set refreshes in the background rather than failing, so a pod that cannot reach its JWKS rejects every token silently — the same gauge Credential Manager exports, for the same reason. Zero here does not stop schedules firing: cron runs inside the process and never presents a token, so expect the firing panels below to keep moving while every UI call is rejected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(auth_jwks_available{job=~\".*datasource-service.*\", namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Firings (5m)",
      "description": "Every firing, scheduled and manual, whatever became of it. Counted where the run row is written, so this and the run history in Postgres cannot disagree.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(job_firings_total{job=~\".*datasource-service.*\", namespace=\"$namespace\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Skipped (5m)",
      "description": "A skipped firing is the concurrency rules working, not a fault — the schedule came due while the definition was already running, or a full scan needed exclusive access. Deliberately not coloured as an error. Skips climbing while submissions fall is the signal to read the Skip Reasons panel: it usually means a schedule fires faster than its scans complete.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(job_firings_total{job=~\".*datasource-service.*\", namespace=\"$namespace\", outcome=\"skipped\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Failed (5m)",
      "description": "Firings that were attempted and did not produce a job: the pipeline could not be ensured, or the job engine rejected the submission. Unlike a skip, nothing ran and nothing will retry until the schedule comes due again.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(job_firings_total{job=~\".*datasource-service.*\", namespace=\"$namespace\", outcome=\"failed\"}[5m]))"
        }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "API Surface & Token Verification",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API Enabled",
      "description": "Aggregated with min, so one pod dropping to 0 pulls the line down rather than being averaged away by its healthy peers. The per-pod split is at the bottom of this board.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(api_enabled{job=~\".*datasource-service.*\", namespace=\"$namespace\"})",
          "legendFormat": "enabled"
        }
      ]
    },
    {
