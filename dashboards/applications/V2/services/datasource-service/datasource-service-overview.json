    {
      "id": 40,
      "type": "timeseries",
      "title": "Firings by Pod (rate)",
      "description": "Where firings are actually originating. Scheduled firings come from whichever pods hold the cron timers, so an uneven split here is normal rather than a load-balancing problem — the useful reading is a pod that stops contributing while staying up, which means its timers are gone but the process is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 50
      },
      "fieldConfig": {
