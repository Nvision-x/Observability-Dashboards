            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (pod) (rate(grpc_requests_total{job=~\".*authz-service.*\", pod=~\"$pod\", namespace=\"$namespace\"}[5m]))",
              "legendFormat": "{{pod}}"
