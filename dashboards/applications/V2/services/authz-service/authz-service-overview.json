              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(grpc_request_duration_seconds_bucket{job=~\".*authz-service.*\", pod=~\"$pod\", namespace=\"$namespace\"}[5m])))",
              "legendFormat": "{{pod}}"
            }
          ]
        },
        {
          "id": 43,
          "type": "timeseries",
          "title": "In Flight by Pod",
          "description": "Where a stuck call is. Normally 0 on every pod.",
