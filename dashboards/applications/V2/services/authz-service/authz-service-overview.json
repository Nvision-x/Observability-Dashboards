          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 6,
            "y": 40
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "lineWidth": 1,
                "fillOpacity": 8,
                "showPoints": "never"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (pod) (rate(grpc_requests_total{job=~\".*authz-service.*\", pod=~\"$pod\", namespace=\"$namespace\", code=~\"$fault_codes\"}[5m]))",
              "legendFormat": "{{pod}}"
            }
          ]
        },
        {
          "id": 42,
          "type": "timeseries",
          "title": "p95 by Pod",
          "description": "A single slow pod points at its own pool or node rather than the database.",
          "datasource": {
