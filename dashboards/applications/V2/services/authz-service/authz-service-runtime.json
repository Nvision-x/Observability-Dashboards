{
  "uid": "apps-v2-authz-service-runtime",
  "title": "Authz Service — Runtime",
  "tags": [
    "git-sync",
    "apps-v2",
    "service:authz-service",
    "runtime"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "folderUid": "apps-v2-authz-service-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Authz Service — Overview",
      "type": "link",
      "url": "/d/apps-v2-authz-service-overview?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus-nx"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*authz-service.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\".*authz-service.*\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "changes(kube_pod_info{namespace=\"$namespace\", pod=~\".*authz-service.*\"}[5m]) > 0",
        "name": "Pod Restarts",
        "tagKeys": "pod",
        "titleFormat": "Pod Restart"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Process — CPU & Memory",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Process CPU (rate)",
      "description": "A request-path service with no background work: every CPU second is an RPC being answered, mostly database reads on the query path. CPU that rises without the RPC rate on the overview board is worth a look at GC Pause and Heap In-Use.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Process Resident Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Process Virtual Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_virtual_memory_bytes{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "Container — Resource Usage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container CPU Usage",
      "description": "Pinned to container=\"authz-service\" rather than container!=\"\". The pod carries a migrations init container, and a per-pod sum over every container folds the schema migration's startup burn into the service's own line, which reads as a CPU spike on every rollout when it is the migration running once.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*authz-service.*\", container=\"authz-service\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Container Memory (working set)",
      "description": "The container limit, not the Go heap, is what the kernel kills on. Compare against Heap In-Use below: a gap that grows without the heap growing is off-heap, and a limit breach shows up here as a restart annotation rather than as anything in the Go panels.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\".*authz-service.*\", container=\"authz-service\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 300,
      "title": "Go Runtime",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Goroutines",
      "description": "No background workers beyond the JWKS refresh and the connection pools, so above the idle floor there is about one goroutine per in-flight RPC. A floor that climbs and does not recede is a call that never returns; RPCs In Flight on the overview board says which RPC.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Heap In-Use",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_inuse_bytes{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "GC Pause (max)",
      "description": "Longest stop-the-world GC pause per pod. go_gc_duration_seconds is a Prometheus summary, not a histogram: there is no _bucket series, so histogram_quantile cannot be used here. The Go collector exposes quantiles 0, 0.25, 0.5, 0.75 and 1 only — there is no 0.99. quantile=\"1\" is the max pause over the runtime's buffer of recent GC cycles, so it reports the worst recent pause rather than a windowed percentile.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_gc_duration_seconds{quantile=\"1\", job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 400,
      "title": "File Descriptors & Threads",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Open vs Max FDs",
      "description": "Sockets here are three Postgres pools (nx-backend, nx-pipeline and this service's own, each capped by its *_MAX_CONNS), the auth-service and credential manager clients, the JWKS fetch and inbound Connect calls. A climb that never recedes is a connection not being returned.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_open_fds{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "open {{pod}}"
        },
        {
          "refId": "B",
          "expr": "process_max_fds{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "max {{pod}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "OS Threads",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_threads{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 500,
      "title": "Uptime & Restarts",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Process Uptime",
      "description": "Time since process start. The service holds no state of its own between calls, so a restart loses nothing but the calls in flight; callers in authz-service mode answer for themselves while no pod is Ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=~\".*authz-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Container Restarts (1h increase)",
      "description": "Counts the whole pod, init container included, so a crashlooping migration shows here even though it never reaches the panels above.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\".*authz-service.*\"}[1h]))",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
