{
  "uid": "apps-v2-registration-service-overview",
  "title": "Registration Service — Overview",
  "tags": [
    "git-sync",
    "apps-v2",
    "service:registration-service",
    "overview"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "folderUid": "apps-v2-registration-service-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Registration Service — Runtime",
      "type": "link",
      "url": "/d/apps-v2-registration-service-runtime?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus-nx" },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*registration-service.*\"}, namespace)",
        "current": { "selected": true, "text": "default", "value": "default" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(process_start_time_seconds{job=~\".*registration-service.*\", namespace=\"$namespace\"}, pod)",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "expr": "changes(kube_pod_info{namespace=\"$namespace\", pod=~\".*registration-service.*\"}[5m]) > 0",
        "name": "Pod Restarts",
        "tagKeys": "pod",
        "titleFormat": "Pod Restart"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Service Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Pods Up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Registrations (last 5m)",
      "description": "Successful RegisterConnector calls in the last 5 minutes (increase of connector_registrations_total). Failed calls are not counted here; see Failed Registrations.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(connector_registrations_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "gRPC Request Rate (5m)",
      "description": "gRPC calls per second across all methods, averaged over 5m.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "gRPC Error % (5m)",
      "description": "Share of gRPC calls returning any non-OK code (code != \"0\"). Client errors such as InvalidArgument (3) and NotFound (5) count; gRPC Server Error % shows server-side failures only.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", code!=\"0\"}[5m])) / clamp_min(sum(rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])), 0.0001)" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "API Request Rate (5m)",
      "description": "REST requests per second under /api/v1, averaged over 5m. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m]))" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "API 5xx % (5m)",
      "description": "Share of /api/v1 requests answered with a 5xx status. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])), 0.0001)" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "gRPC In Flight",
      "description": "grpc_active_requests — unary calls currently executing inside the metrics interceptor.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(grpc_active_requests{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "HTTP In Flight",
      "description": "http_active_requests has no route label, so it includes health probes and /metrics scrapes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(http_active_requests{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "gRPC p95 (5m)",
      "description": "95th-percentile gRPC call latency over 5m, all methods.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])))" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "API p95 (5m)",
      "description": "95th-percentile latency of /api/v1 requests over 5m. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])))" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "gRPC Server Error % (5m)",
      "description": "Share of gRPC calls failing with a server-side code: Unknown (2), DeadlineExceeded (4), ResourceExhausted (8), Unimplemented (12), Internal (13), Unavailable (14), DataLoss (15). Client errors are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", code=~\"2|4|8|12|13|14|15\"}[5m])) / clamp_min(sum(rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])), 0.0001)" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "API 4xx % (5m)",
      "description": "Share of /api/v1 requests answered with a 4xx status, e.g. 401 from auth or 404 for an unknown connector. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\", status=~\"4..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])), 0.0001)" }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "Connector Registrations",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Registrations by Connector (5m increase)",
      "description": "connector_registrations_total counts successful RegisterConnector calls. Connectors re-register on every startup, so steps here usually line up with connector rollouts.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum by (connector) (increase(connector_registrations_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{connector}}" }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Failed Registrations (5m increase)",
      "description": "RegisterConnector calls that returned a non-OK gRPC code, by code (from grpc_requests_total). connector_registrations_total counts successes only, so failures show only here.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (increase(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", method=~\".*/RegisterConnector\", code!=\"0\"}[5m]))", "legendFormat": "code {{code}}" }
      ]
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Registrations by Connector (dashboard window)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "targets": [
        { "refId": "A", "expr": "sum by (connector) (increase(connector_registrations_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[$__range]))", "legendFormat": "{{connector}}", "instant": true }
      ]
    },
    {
      "type": "row",
      "id": 300,
      "title": "gRPC — Registration API",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "gRPC Request Rate by Method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (method) (rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "gRPC Request Rate by Status Code",
      "description": "The `code` label is the numeric gRPC status (0 = OK). The `status` label carries the full formatted status string and is intentionally not used for grouping.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "code {{code}}" }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "gRPC In Flight by Method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum by (method) (grpc_active_requests{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "gRPC Duration — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "gRPC Mean Duration by Method",
      "description": "Mean call duration per method: rate of the duration sum over rate of the count, 5m window.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "sum by (method) (rate(grpc_request_duration_seconds_sum{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) / clamp_min(sum by (method) (rate(grpc_request_duration_seconds_count{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])), 0.0001)", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "gRPC Errors by Method and Code",
      "description": "Non-OK gRPC calls per second, by method and numeric code. Grouped by code, never by the free-text status label.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (method, code) (rate(grpc_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", code!=\"0\"}[5m]))", "legendFormat": "{{method}} code {{code}}" }
      ]
    },
    {
      "type": "row",
      "id": 400,
      "title": "HTTP — REST API",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "panels": []
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "HTTP Request Rate by Route",
      "description": "Requests per second by chi route pattern, e.g. /api/v1/connectors/{name}/config-schema. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded. \"unmatched\" is a request that matched no route; /api/v1/* is one answered by auth or CORS before routing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route!~\"/metrics|/health|/ready|/readiness|/live|/liveness\"}[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "HTTP Request Rate by Status",
      "description": "Requests per second by HTTP status. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded. Unmatched routes are included, so 404s from stray paths show here.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route!~\"/metrics|/health|/ready|/readiness|/live|/liveness\"}[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "API Duration — p50 / p95 / p99",
      "description": "Latency percentiles of /api/v1 requests over 5m. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "API Mean Duration by Route",
      "description": "Mean request duration per /api/v1 route: rate of the duration sum over rate of the count, 5m window. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(http_request_duration_seconds_sum{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])) / clamp_min(sum by (route) (rate(http_request_duration_seconds_count{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m])), 0.0001)", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "API Payload Throughput",
      "description": "Bytes/s in and out of /api/v1, from the http_request_size_bytes / http_response_size_bytes sums. The request series stays near 0: the REST API is GET-only and request size is recorded only when ContentLength > 0. Health probes (/health, /ready, /live, /readiness, /liveness) and /metrics scrapes are excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_request_size_bytes_sum{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m]))", "legendFormat": "request" },
        { "refId": "B", "expr": "sum(rate(http_response_size_bytes_sum{job=~\".*registration-service.*\", namespace=\"$namespace\", pod=~\"$pod\", route=~\"/api/v1/.*\"}[5m]))", "legendFormat": "response" }
      ]
    },
    {
      "type": "row",
      "id": 450,
