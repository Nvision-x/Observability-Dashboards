{
  "uid": "apps-v2-credentialmanager-overview",
  "title": "Credential Manager — Overview",
  "folderUid": "apps-v2-credentialmanager-folder",
  "tags": [
    "git-sync",
    "apps-v2",
    "service:credentialmanager",
    "overview"
  ],
  "timezone": "utc",
  "editable": null,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Credential Manager — Runtime",
      "type": "link",
      "url": "/d/apps-v2-credentialmanager-runtime?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus-nx"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*credentialmanager.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "description": "Applies only to the per-pod panels at the bottom. Aggregate panels ignore it so pod churn does not gap the graphs.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Service Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Pods Up",
      "description": "Connectors reach this service over gRPC on GRPC_PORT. A pod that is down is a credential lookup failure for every connector; the gRPC row below is that surface's own RED signals.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "JWKS Available",
      "description": "1 while the JWT authority key set is loaded, 0 while it is unreachable or empty. Zero does not mean this service is down: the gRPC CredentialService that connectors depend on never touches the JWKS, and this is deliberately kept out of the health probes so Kubernetes does not restart the pod or pull it from the Service over it. What it does mean is that every request to the UI-facing Connect API is being rejected, while the gRPC panels below should be entirely unaffected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(auth_jwks_available{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Admin API Requests (5m)",
      "description": "Requests to the UI-facing Connect API, health and metrics endpoints included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Admin API Errors (5m)",
      "description": "Non-2xx responses over the last five minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\", status!~\"2..\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unauthorized (5m)",
      "description": "401 and 403 together. A sustained climb with JWKS Available at 0 is the signature of a JWT-authority outage rather than a caller problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\", status=~\"401|403\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "In Flight",
      "description": "HTTP requests currently being served.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_active_requests{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "JWT Authority (JWKS)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "JWKS Availability",
      "description": "keyfunc does not fail when the JWKS host is unreachable -- it serves an empty key set and retries in the background -- so this gauge is the only signal that the UI-facing API is rejecting everything. Alert on it here: it is deliberately not a health check, because a 503 on /health restarts the pod and an unready pod leaves the Service, cutting off the connector gRPC API over a dependency none of them use.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(auth_jwks_available{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Rejected Requests vs JWKS",
      "description": "Overlays the 401/403 rate on the gauge. The two moving together is a JWKS outage; 401s without it are ordinary bad tokens.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\", status=~\"401|403\"}[5m]))",
          "legendFormat": "401 + 403 rate"
        },
        {
          "refId": "B",
          "expr": "min(auth_jwks_available{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})",
          "legendFormat": "jwks available"
        }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "Credential Service — gRPC (connectors)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Request Rate by Method",
      "description": "GetConnectorCredential is the hot path: every connector calls it to resolve a datasource credential before it can read anything.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(grpc_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Errors by Code",
      "description": "code=\"0\" is OK and is excluded. code=\"5\" (NotFound) is a connector asking for a credential that was never provisioned, which is a configuration problem rather than a fault here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(grpc_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\", code!=\"0\"}[5m]))",
          "legendFormat": "code {{code}}"
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Duration p50 / p95 / p99",
      "description": "On the SubsecondLatencyBuckets ladder. A connector blocks on this call before it can fetch anything, so latency here is latency for every scan.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(grpc_request_duration_seconds_bucket{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Error Ratio (non-OK)",
      "description": "Share of calls returning a non-OK code.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(grpc_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\", code!=\"0\"}[5m])) / clamp_min(sum(rate(grpc_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "In Flight",
      "description": "Concurrent calls being served.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grpc_active_requests{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})",
          "legendFormat": "in flight"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Admin API — Connect",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Request Rate by Route",
      "description": "Per-route throughput. The Connect RPCs share one path prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Request Rate by Status",
      "description": "401 and 403 separate out the authentication and authorization failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Duration p95 by Route",
      "description": "Buckets are the SubsecondLatencyBuckets ladder this service opts into, so percentiles are meaningful rather than interpolated inside a single bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Error Ratio (non-2xx)",
      "description": "Share of responses that are not 2xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\", status!~\"2..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Payload Throughput",
      "description": "Request and response bytes. Credential writes carry an opaque Any, so a sudden change in request size is worth a look.",
