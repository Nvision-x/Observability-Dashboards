      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_size_bytes_sum{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m]))",
          "legendFormat": "request"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_response_size_bytes_sum{job=~\".*credentialmanager.*\", namespace=\"$namespace\"}[5m]))",
          "legendFormat": "response"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "In Flight",
