          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_active_requests{job=~\".*credentialmanager.*\", namespace=\"$namespace\"})",
          "legendFormat": "in flight"
        }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "Per-Pod Drill-Down",
