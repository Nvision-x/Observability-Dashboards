{
  "uid": "apps-v2-box-runtime",
  "title": "Box Connector \u2014 Runtime",
  "tags": [
    "git-sync",
    "apps-v2",
    "connector:box",
    "runtime"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "folderUid": "apps-v2-box-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Box \u2014 Overview",
      "type": "link",
      "url": "/d/apps-v2-box-overview?${namespace:queryparam}&${component:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Box \u2014 Pipeline",
      "type": "link",
      "url": "/d/apps-v2-box-pipeline?${namespace:queryparam}&${component:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 \u2014 Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus-nx"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "description": "Fed from kube-state-metrics, never from process_start_time_seconds: box is minReplicaCount 0, so a process-lifecycle metric leaves the variable \u2014 and the whole board \u2014 empty in the connector's normal state.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*box-connector-be-go.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "component",
        "type": "custom",
        "label": "Component",
        "query": "All : .*box-connector-be-go.*, Scanner : .*box-connector-be-go, Content : .*box-connector-be-go-content",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*box-connector-be-go.*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*box-connector-be-go.*"
          },
          {
            "selected": false,
            "text": "Scanner",
            "value": ".*box-connector-be-go"
          },
          {
            "selected": false,
            "text": "Content",
            "value": ".*box-connector-be-go-content"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "description": "allValue is .+ and not .*: every series is scraped twice in dev (PodMonitor plus the kubernetes-services catch-all) and only the PodMonitor copy carries a pod label. In PromQL .* also matches the absent label, which doubles every additive aggregation.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\"$component\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "changes(kube_pod_info{namespace=\"$namespace\", pod=~\".*box-connector.*\"}[5m]) > 0",
        "name": "Pod Restarts",
        "tagKeys": "pod",
        "titleFormat": "Pod Restart"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to read this board",
      "options": {
        "mode": "markdown",
        "content": "**Is the connector itself healthy?** CPU, memory, Go runtime and file handles for the scanner and content pods. Use the *component* selector at the top to look at one of them.\n\n**Empty is normal:** both deployments scale to zero between jobs, so this board only has data while something runs.\n\nHover the \u24d8 on any panel for what it shows, what is normal, and where to look next.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "id": 401,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "id": 100,
      "title": "Process \u2014 CPU & Memory",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Process CPU (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**CPU the connector process uses**, in cores, per pod.\n\n**Normal:** near 0 when idle, up to the limit (0.1 core for both scanner and content) during work. Pinned at 0.1 means the pod is being throttled and everything slows down.\n\n**Next:** 'Container CPU Usage' for what Kubernetes sees."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Process Resident Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**Memory the process is really using** (what is in RAM), per pod.\n\n**Normal:** well below the 256 MiB limit. A line that only goes up across several scans points at memory that is never released.\n\n**Next:** 'Container Memory (working set)' \u2014 the number Kubernetes kills on."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Process Virtual Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_virtual_memory_bytes{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**Memory the process has reserved**, used or not. Go reserves far more than it uses.\n\n**Normal:** large and flat. Not a useful alarm on its own \u2014 use resident memory.\n\n**Next:** 'Process Resident Memory'."
    },
    {
      "type": "row",
      "id": 200,
      "title": "Container \u2014 Resource Usage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container CPU Usage",
      "description": "**CPU per pod as Kubernetes measures it**, for both scanner and content pods. Kubernetes' own metrics do not carry the connector's labels, so these container panels pick pods by name and ignore the Component selector.\n\n**Normal:** same shape as Process CPU. At 0.1 core the pod is at its limit.\n\n**Next:** 'Process CPU' for the connector's own view.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*box-connector.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Container Memory (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\".*box-connector.*\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**Memory per pod as Kubernetes measures it** \u2014 the number it compares with the 256 MiB limit. Covers both scanner and content pods.\n\n**Normal:** well below 256 MiB. Reaching it gets the pod killed (OOMKilled) and the work it held is retried.\n\n**Next:** 'Restarts (1h)' on the Overview."
    },
    {
      "type": "row",
      "id": 300,
      "title": "Go Runtime",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**How many concurrent tasks the program is running.**\n\n**Normal:** grows during a scan and returns to a low, steady number after. A count that keeps growing between scans is a leak.\n\n**Next:** 'Folder work in flight' on the Pipeline board for the scanner's own work count."
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Heap In-Use",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_inuse_bytes{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**Memory used by the program's own data.**\n\n**Normal:** rises during work and drops after garbage collection. Floors that keep rising across scans mean something is being kept.\n\n**Next:** 'Process Resident Memory'."
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "GC Pause \u2014 max & median",
      "description": "**How long the program pauses to clean up memory.** Max = the worst pause, median = a typical one. Only these fixed points (min, quartiles, max) exist for this measurement, so there is no 99th percentile.\n\n**Normal:** milliseconds. Pauses of hundreds of milliseconds mean memory pressure \u2014 check memory against the 256 MiB limit.\n\n**Next:** 'Heap In-Use'.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_gc_duration_seconds{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\", quantile=\"1\"}",
          "legendFormat": "max {{pod}}"
        },
        {
          "refId": "B",
          "expr": "go_gc_duration_seconds{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\", quantile=\"0.5\"}",
          "legendFormat": "p50 {{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 400,
      "title": "File Descriptors & Threads",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Open vs Max FDs",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_open_fds{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "open {{pod}}"
        },
        {
          "refId": "B",
          "expr": "process_max_fds{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "max {{pod}}"
        }
      ],
      "description": "**Open files and network connections against the process limit.**\n\n**Normal:** far below the limit. Each Box API connection and message-queue connection is one of these; a count that only grows means connections are not being closed.\n\n**Next:** 'Goroutines'."
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "OS Threads",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_threads{job=~\"$component\", namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "**Operating-system threads the program uses.**\n\n**Normal:** a small, steady number. Growing steadily means calls are blocking.\n\n**Next:** 'Goroutines'."
    }
  ]
}
