{
  "uid": "apps-v2-cifs-overview",
  "title": "CIFS Connector — Overview",
  "tags": [
    "git-sync",
    "apps-v2",
    "connector:cifs",
    "overview"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "folderUid": "apps-v2-cifs-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "CIFS — Pipeline",
      "type": "link",
      "url": "/d/apps-v2-cifs-pipeline?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "CIFS — Runtime",
      "type": "link",
      "url": "/d/apps-v2-cifs-runtime?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus-nx"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*cifs-connector-be-go.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\".*cifs-connector-be-go.*\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "changes(kube_pod_info{namespace=\"$namespace\", pod=~\".*cifs-connector.*\"}[5m]) > 0",
        "name": "Pod Restarts",
        "tagKeys": "pod",
        "titleFormat": "Pod Restart"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Scanner — cifs-connector-be-go",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Pods Up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*cifs-connector-be-go\", namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Restarts (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", container=\"cifs-connector-be-go\"}[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mounts Active",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cifs_scanner_mount_active{namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Files Discovered (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_scanner_files_discovered_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Files Processed (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_scanner_files_processed_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Items Sent (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_scanner_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "ACL Errors (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_scanner_acl_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Scan p95 (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cifs_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Scanner Throughput (rate, 5m)",
      "description": "discovered = files that reached processing; sent = items handed to the batch sender. files_processed_total and items_sent_total are incremented on adjacent lines in the same else-branch (cifsscan.go), so they are identical by construction and the real funnel is discovered to sent. Neither counter carries datasource_id, so a loss cannot yet be attributed to a share.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_scanner_files_discovered_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "files discovered"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cifs_scanner_files_processed_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "files processed"
        },
        {
          "refId": "C",
          "expr": "sum(rate(cifs_scanner_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "items sent"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Errors by Source (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_scanner_acl_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "scanner acl errors"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cifs_augmenter_acl_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "augmenter acl errors"
        },
        {
          "refId": "C",
          "expr": "sum(rate(cifs_scanner_worker_connect_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "worker connect errors"
        },
        {
          "refId": "D",
          "expr": "sum(rate(cifs_scanner_worker_reconnects_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "worker reconnects"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Scan Duration — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(cifs_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cifs_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cifs_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Local Stack Depth (DFS backlog)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cifs_scanner_local_stack_depth{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "max depth"
        },
        {
          "refId": "B",
          "expr": "sum(cifs_scanner_local_stack_depth{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "sum across pods"
        }
      ]
    },
    {
      "type": "row",
      "id": 150,
      "title": "Scanner — Backlog & Autoscaling",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": []
    },
    {
      "id": 50,
      "type": "stat",
      "title": "Scanner Backlog",
      "description": "Messages waiting on the scanner durable - the answer to \"how backed up is it\". Scanner and augmenter run in the same deployment and share this one durable (cifs-scanner-v1): handleCifsForkJE and handleItemBatchJE are dispatched by message type off a single consumer. num_pending therefore blends CIFSFork and ItemBatch work, so augmenter backlog is not separable here and KEDA cannot tell them apart either. Server-side signal from the NATS exporter (no namespace/pod labels).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nats_consumer_num_pending{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})"
        }
      ]
    },
    {
      "id": 51,
      "type": "stat",
      "title": "In Flight (unacked)",
      "description": "Delivered but not yet acked: work currently inside the pods. Also the signal KEDA's ack-capacity trigger scales on. Server-side signal from the NATS exporter (no namespace/pod labels).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nats_consumer_num_ack_pending{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})"
        }
      ]
    },
    {
      "id": 52,
      "type": "stat",
      "title": "Redelivered",
      "description": "Messages redelivered after an ack timeout. Sustained growth with a flat items_sent rate is the stalled-connector signature. Server-side signal from the NATS exporter (no namespace/pod labels).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nats_consumer_num_redelivered{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})"
        }
      ]
    },
    {
      "id": 53,
      "type": "stat",
      "title": "Replicas",
      "description": "Current replicas of the scanner deployment, from the HPA KEDA manages. minReplicaCount is 0, so 0 replicas with an empty queue is normal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\", horizontalpodautoscaler=~\".*cifs-connector-be-go\"})"
        }
      ]
    },
    {
      "id": 54,
      "type": "stat",
      "title": "Max Replicas",
      "description": "Ceiling from the ScaledObject. Replicas pinned here while the backlog grows means the connector is capped, not idle.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\", horizontalpodautoscaler=~\".*cifs-connector-be-go\"})"
        }
      ]
    },
    {
      "id": 55,
      "type": "stat",
      "title": "Backlog Slope (2m)",
      "description": "Per-second growth of the backlog, clamped at 0. Verbatim the query KEDA's trend-based trigger evaluates; above 0.5 it asks for more pods.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(max(deriv(nats_consumer_num_pending{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"}[2m])), 0)"
        }
      ]
    },
    {
      "id": 56,
      "type": "timeseries",
      "title": "Scanner Consumer Backlog",
      "description": "Backlog on JE_CIFS/cifs-scanner-v1. Pending high while items_sent is flat means the connector is not draining. Scanner and augmenter run in the same deployment and share this one durable (cifs-scanner-v1): handleCifsForkJE and handleItemBatchJE are dispatched by message type off a single consumer. num_pending therefore blends CIFSFork and ItemBatch work, so augmenter backlog is not separable here and KEDA cannot tell them apart either. Server-side signal from the NATS exporter (no namespace/pod labels).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nats_consumer_num_pending{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "max(nats_consumer_num_ack_pending{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})",
          "legendFormat": "ack pending (in flight)"
        },
        {
          "refId": "C",
          "expr": "max(nats_consumer_num_redelivered{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})",
          "legendFormat": "redelivered"
        }
      ]
    },
    {
      "id": 57,
      "type": "timeseries",
      "title": "KEDA — Replicas: current vs desired vs max",
      "description": "current below desired means scaling is in progress or blocked; current pinned at max means capped. Scale-down is deliberately slow (cooldown 900s, 600s stabilization window), so a flat line for ten minutes after a burst is configuration, not a stuck HPA.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\", horizontalpodautoscaler=~\".*cifs-connector-be-go\"})",
          "legendFormat": "current"
        },
        {
          "refId": "B",
          "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\", horizontalpodautoscaler=~\".*cifs-connector-be-go\"})",
          "legendFormat": "desired"
        },
        {
          "refId": "C",
          "expr": "max(kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\", horizontalpodautoscaler=~\".*cifs-connector-be-go\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 58,
      "type": "timeseries",
      "title": "KEDA — ack-capacity signal vs threshold",
      "description": "KEDA's ack-capacity trigger: replicas = ceil(ack_pending / 1000). The red line is that threshold; crossing it is what asks for another pod.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nats_consumer_num_ack_pending{stream_name=\"JE_CIFS\", consumer_name=\"cifs-scanner-v1\"})",
          "legendFormat": "ack pending"
        }
      ]
    },
    {
      "id": 59,
      "type": "timeseries",
      "title": "KEDA — trend-based signal vs threshold",
      "description": "KEDA's trend-based trigger: slope of the backlog over 2m, clamped at 0 so only growth counts. Threshold 0.5, activation 0.1. The pipeline-full trigger is not rendered in dev (capacity is unset), so this plus ack-capacity and pending-wakeup is the whole scaling story.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
