    },
    {
      "id": 70,
      "type": "stat",
      "title": "Files Gone (5m)",
      "description": "Files discovered by an earlier scan that were no longer on the share when the augmenter or the content fetcher went back for them. Caveat on the content series: FETCH_ERROR_NOT_FOUND is emitted from three places and only one is a vanished file - fs.ErrNotExist, an ELOOP on a symlink swapped in mid-open, and the not-a-regular-file rejection in handler.go, which fires for symlinks, devices, pipes and sockets. On a share with symlinks this over-counts. Splitting it needs a connector change (a distinct metric label behind the same wire code).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 81 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
