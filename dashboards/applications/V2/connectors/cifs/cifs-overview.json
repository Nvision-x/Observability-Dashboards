        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(cifs_augmenter_items_processed_total{namespace=\"$namespace\", pod=~\"$pod\", outcome=\"missing\"}[5m])) or vector(0)) + (sum(increase(cifs_content_fetch_total{namespace=\"$namespace\", pod=~\"$pod\", error_code=\"FETCH_ERROR_NOT_FOUND\"}[5m])) or vector(0))"
        }
      ]
    },
    {
      "id": 71,
      "type": "timeseries",
      "title": "Files Gone by stage (rate, 5m)",
      "description": "Two series on purpose: a file missing at augment time and one missing at content-fetch time are different moments in the pipeline and are diagnosed differently. Caveat on the content series: FETCH_ERROR_NOT_FOUND is emitted from three places and only one is a vanished file - fs.ErrNotExist, an ELOOP on a symlink swapped in mid-open, and the not-a-regular-file rejection in handler.go, which fires for symlinks, devices, pipes and sockets. On a share with symlinks this over-counts. Splitting it needs a connector change (a distinct metric label behind the same wire code).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 81 },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cifs_augmenter_items_processed_total{namespace=\"$namespace\", pod=~\"$pod\", outcome=\"missing\"}[5m]))",
          "legendFormat": "augment - no longer on share"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cifs_content_fetch_total{namespace=\"$namespace\", pod=~\"$pod\", error_code=\"FETCH_ERROR_NOT_FOUND\"}[5m]))",
          "legendFormat": "content - NOT_FOUND (includes non-regular files)"
        }
      ]
    }
  ]
