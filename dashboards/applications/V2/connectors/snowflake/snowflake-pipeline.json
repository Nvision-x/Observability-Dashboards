{
  "uid": "apps-v2-snowflake-pipeline",
  "title": "Snowflake Connector — Pipeline",
  "tags": [
    "git-sync",
    "apps-v2",
    "connector:snowflake",
    "pipeline"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "folderUid": "apps-v2-snowflake-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Snowflake — Overview",
      "type": "link",
      "url": "/d/apps-v2-snowflake-overview?${namespace:queryparam}&${component:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Snowflake — Runtime",
      "type": "link",
      "url": "/d/apps-v2-snowflake-runtime?${namespace:queryparam}&${component:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "options": [],
        "current": {
          "text": "default",
          "value": "default"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_spec_replicas{deployment=~\".*snowflake-connector-be-go.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "component",
        "type": "custom",
        "label": "Component",
        "query": "All : .*snowflake-connector-be-go.*, Scanner : .*snowflake-connector-be-go, Content : .*snowflake-connector-be-go-content",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*snowflake-connector-be-go.*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*snowflake-connector-be-go.*"
          },
          {
            "selected": false,
            "text": "Scanner",
            "value": ".*snowflake-connector-be-go"
          },
          {
            "selected": false,
            "text": "Content",
            "value": ".*snowflake-connector-be-go-content"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\"$component\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "query_type",
        "type": "query",
        "label": "Query Type",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(snowflake_scanner_query_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}, query_type)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Scanner — Discovery & Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tables Scanned by Mode (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (mode) (rate(snowflake_scanner_tables_scanned_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{mode}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Columns Found by Mode (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (mode) (rate(snowflake_scanner_columns_found_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{mode}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Items Sent (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_scanner_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "items/s" }
      ]
    },
    {
      "type": "row",
      "id": 150,
      "title": "Scanner — Errors & In Flight",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "panels": []
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Scanner Errors (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_scanner_database_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "database" },
        { "refId": "B", "expr": "sum(rate(snowflake_scanner_table_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "table" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Scanner — In Flight",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(snowflake_scanner_scanstart_in_flight{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "scanstart" },
        { "refId": "B", "expr": "sum(snowflake_scanner_tables_in_flight{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "tables (fanout)" },
        { "refId": "C", "expr": "sum(snowflake_scanner_bulk_schemas_in_flight{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "bulk schemas" }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "Scanner — Query Performance",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "panels": []
    },
    {
      "id": 10,
      "type": "heatmap",
      "title": "Query Duration Heatmap",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (le) (rate(snowflake_scanner_query_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\", query_type=~\"$query_type\"}[5m]))", "format": "heatmap", "legendFormat": "{{le}}" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Query p95 by query_type",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, query_type) (rate(snowflake_scanner_query_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\", query_type=~\"$query_type\"}[5m])))", "legendFormat": "{{query_type}}" }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Scanner Connections by Type",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(snowflake_scanner_connections_open{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "open" },
        { "refId": "B", "expr": "sum(snowflake_scanner_connections_in_use{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "in-use" },
        { "refId": "C", "expr": "sum(snowflake_scanner_connections_idle{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "idle" }
      ]
    },
    {
      "type": "row",
      "id": 250,
      "title": "Content — Activity",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Content — In Flight",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(snowflake_content_fetch_in_flight{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "fetches" }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Content Connections by Type",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(snowflake_content_connections_open{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "open" },
        { "refId": "B", "expr": "sum(snowflake_content_connections_in_use{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "in-use" },
        { "refId": "C", "expr": "sum(snowflake_content_connections_idle{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "idle" }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Content Requests by outcome (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(snowflake_content_requests_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "type": "row",
      "id": 300,
      "title": "Content — Fetch & Streaming",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Content Fetch Duration — p50 / p95 / p99 by outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(snowflake_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p50 {{outcome}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(snowflake_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p95 {{outcome}}" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(snowflake_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p99 {{outcome}}" }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Content Stream Duration — p50 / p95 / p99",
      "description": "Wall-clock duration of the streaming pipeline (Snowflake row pull + UploadFrom). The two legs run concurrently through an io.Pipe, so this reflects the slower of the two at any moment. Replaces the old separate Query Duration and Upload Duration metrics, which can't be measured independently in the streaming architecture.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(snowflake_content_stream_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_content_stream_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(snowflake_content_stream_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Content Stream Bytes — p50 / p95 / p99",
      "description": "Bytes streamed per successful content fetch (Info.Size echoed back by the content transfer service). Useful for sizing impact of large-payload streaming and spotting outliers.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(snowflake_content_stream_bytes_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_content_stream_bytes_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(snowflake_content_stream_bytes_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Content Stream Rows — Rate (rows/s)",
      "description": "Total rows streamed per second across successful content fetches.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_content_stream_rows_sum{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "rows/s" }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Content Stream Rows — Avg per Fetch",
      "description": "Average rows streamed per successful content fetch (sum / count over a 5-minute window).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_content_stream_rows_sum{namespace=\"$namespace\", pod=~\"$pod\"}[5m])) / sum(rate(snowflake_content_stream_rows_count{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "avg rows/fetch" }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Content Connections (Open) by Pod",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (snowflake_content_connections_open{namespace=\"$namespace\", pod=~\"$pod\"})", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Sample Verify-Empty by Outcome (count, 5m)",
      "description": "Count of times the verify-at-100% branch fired during content sampling. outcome=\"recovered\" means phase-1 SAMPLE SYSTEM returned zero rows on a non-empty table and the re-run rescued data — sustained > 0 means SamplePercent is too low for the row distribution. outcome=\"empty\" means the re-run also returned nothing — table is genuinely empty, no action needed. Replaces the old sample_fallback_total metric.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (increase(snowflake_content_sample_verify_empty_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "type": "row",
      "id": 310,
      "title": "Errors & Connection Test",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "panels": []
    },
    {
      "id": 311,
      "type": "timeseries",
      "title": "Errors by Code and Operation (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (error_code, operation) (rate(snowflake_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{error_code}} / {{operation}}" }
      ]
    },
    {
      "id": 312,
      "type": "timeseries",
      "title": "Connection Test Outcomes (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(snowflake_connectiontest_requests_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 313,
      "type": "timeseries",
      "title": "Connection Test Objects Skipped (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (rate(snowflake_connectiontest_object_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{level}}" }
      ]
    },
    {
      "id": 314,
      "type": "timeseries",
      "title": "Connection Test Duration by Depth (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, depth) (rate(snowflake_connectiontest_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "{{depth}}" }
      ]
    },
    {
      "type": "row",
      "id": 1310,
      "title": "Registration",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 73
      },
      "panels": []
    },
    {
      "id": 1311,
      "type": "state-timeline",
      "title": "Registration State by Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "**Whether each pod has registered itself with the registration service**, shown as the current state over time: registered, pending (no answer yet), unreachable (the registry or network is failing), rejected (the registry refused, retrying), rejected_final (refused for good), build_failed (the registration could not be built), lane_missing (no test-connection lane is being served), disabled (registration is switched off).\n\nThe registration series exist only on builds that include the registration-metrics change, so older pods show No data here. Connector pods scale to zero, so a pod's line exists only while a scanner pod is running.\n\n**Normal:** registered, after a short pending at start-up. lane_missing, rejected_final and build_failed are the states to alert on: no other panel reports them, and the pod is not registering. unreachable held for longer than a deploy takes is worth alerting on too.\n\n**Next:** 'Registration Attempts by Result' for whether attempts are still failing, and the connector logs for the reason.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "disabled",
                  "color": "gray",
                  "index": 0
                },
                "2": {
                  "text": "pending",
                  "color": "blue",
                  "index": 1
                },
                "3": {
                  "text": "unreachable",
                  "color": "orange",
                  "index": 2
                },
                "4": {
                  "text": "rejected",
                  "color": "orange",
                  "index": 3
                },
                "5": {
                  "text": "registered",
                  "color": "green",
                  "index": 4
                },
                "6": {
                  "text": "rejected_final",
                  "color": "red",
                  "index": 5
                },
                "7": {
                  "text": "build_failed",
                  "color": "red",
                  "index": 6
                },
                "8": {
                  "text": "lane_missing",
                  "color": "red",
                  "index": 7
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"disabled\"}) * 1) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"pending\"}) * 2) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"unreachable\"}) * 3) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"rejected\"}) * 4) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"registered\"}) * 5) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"rejected_final\"}) * 6) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"build_failed\"}) * 7) + on(pod) (max by (pod) (snowflake_registration_state{namespace=\"$namespace\", pod=~\"$pod\",state=\"lane_missing\"}) * 8)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 1312,
      "type": "bargauge",
      "title": "Registration Attempts by Result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "**Registration attempts made in the selected range**, by result: success (the registry accepted it), rejected (the registry refused it), failed (no answer: the registry was unreachable or failing). Totals add up every attempt of every pod in the range.\n\n**Normal:** a success at start-up and one about every 6 hours when the pod renews. Rejected or failed attempts that keep coming mean the pod is not (re-)registering. A pod can still read registered while renewals fail, so this is the panel that shows it.\n\n**Next:** 'Registration Attempts (rate, 5m)' beside it for when, and 'Registration State by Pod' for the pod's current state.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 82
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "expr": "sum by (result) (sum_over_time(((last_over_time(snowflake_registration_attempts_total{namespace=\"$namespace\", pod=~\"$pod\"}[15s]) - last_over_time(snowflake_registration_attempts_total{namespace=\"$namespace\", pod=~\"$pod\"}[1d] offset 15s)) >= 0 or last_over_time(snowflake_registration_attempts_total{namespace=\"$namespace\", pod=~\"$pod\"}[15s]) * 1)[$__range:15s])) > 0",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 1313,
      "type": "timeseries",
      "title": "Registration Attempts (rate, 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "**When registration attempts happened**, by result, stacked. An attempt is rare, so a single one can read near 0 here and still be counted in 'Registration Attempts by Result'.\n\n**Normal:** a short green mark at start-up and every 6 hours. A steady orange or red line means the pod keeps trying and the registry keeps refusing it or not answering.\n\n**Next:** 'Registration State by Pod'; the registration service board for its side.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 8,
        "y": 82
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(snowflake_registration_attempts_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 1314,
      "type": "stat",
      "title": "Since Last Success",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "**How long since any pod last registered successfully**, measured from the newest success among the selected pods.\n\n**Normal:** under 6 hours, because the connector re-registers every 6 hours. Well beyond that means renewals are failing even if the state still reads registered. No data means no scanner pod is running (they scale to zero) or the pod's build predates the registration metrics.\n\n**Next:** 'Registration Attempts by Result' for what the attempts are returning.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 82
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "expr": "time() - max(snowflake_registration_last_success_timestamp_seconds{namespace=\"$namespace\", pod=~\"$pod\"} > 0)"
        }
      ]
    }
  ]
}
