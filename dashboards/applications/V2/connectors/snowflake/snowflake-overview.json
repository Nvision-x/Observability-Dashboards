{
  "uid": "apps-v2-snowflake-overview",
  "title": "Snowflake Connector — Overview",
  "tags": ["git-sync", "apps-v2", "connector:snowflake", "overview"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "folderUid": "apps-v2-snowflake-folder",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    {
      "title": "Snowflake — Pipeline",
      "type": "link",
      "url": "/d/apps-v2-snowflake-pipeline?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Snowflake — Runtime",
      "type": "link",
      "url": "/d/apps-v2-snowflake-runtime?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus-nx" },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=~\"snowflake-connector-be-go.*\"}, namespace)",
        "current": { "selected": false, "text": "default", "value": "default" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=~\"snowflake-connector-be-go.*\", namespace=\"$namespace\"}, pod)",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "expr": "changes(kube_pod_info{namespace=\"$namespace\", pod=~\".*snowflake-connector.*\"}[5m]) > 0",
        "name": "Pod Restarts",
        "tagKeys": "pod",
        "titleFormat": "Pod Restart"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Scanner — snowflake-connector-be-go",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Scanner Pods Up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"snowflake-connector-be-go\", namespace=\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Items Sent (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scan Duration p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_connector_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_database_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m])) + sum(rate(snowflake_connector_table_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Throughput — Items / Tables / Columns (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "items sent" },
        { "refId": "B", "expr": "sum(rate(snowflake_connector_tables_scanned_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "tables scanned" },
        { "refId": "C", "expr": "sum(rate(snowflake_connector_columns_found_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "columns found" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scan Duration — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(snowflake_connector_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_connector_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(snowflake_connector_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_database_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "database errors" },
        { "refId": "B", "expr": "sum(rate(snowflake_connector_table_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "table errors" }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "Content — snowflake-connector-be-go-content",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Content Pods Up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"snowflake-connector-be-go-content\", namespace=\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Active Content Pools",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(snowflake_connector_content_pools_active{namespace=\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Content Fetches (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_content_requests_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Content Fetch p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_connector_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))" }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Content Upload p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_connector_content_cache_write_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))" }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Content Requests by Outcome (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(snowflake_connector_content_requests_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Content Fetch Duration — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(snowflake_connector_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_connector_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(snowflake_connector_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))", "legendFormat": "p99" }
      ]
    }
  ]
}
