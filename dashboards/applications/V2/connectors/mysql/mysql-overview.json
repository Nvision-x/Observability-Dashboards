{
  "uid": "apps-v2-mysql-overview",
  "title": "MySQL Connector — Overview",
  "tags": [
    "git-sync",
    "apps-v2",
    "connector:mysql",
    "overview"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "folderUid": "apps-v2-mysql-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "MySQL — Pipeline",
      "type": "link",
      "url": "/d/apps-v2-mysql-pipeline?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "MySQL — Runtime",
      "type": "link",
      "url": "/d/apps-v2-mysql-runtime?${namespace:queryparam}",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Applications V2 — Overview",
      "type": "link",
      "url": "/d/apps-v2-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus-nx"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\".*mysql-connector-be-go.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_start_time_seconds{job=~\".*mysql-connector-be-go.*\", namespace=\"$namespace\"}, pod)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "changes(kube_pod_info{namespace=\"$namespace\", pod=~\".*mysql-connector.*\"}[5m]) > 0",
        "name": "Pod Restarts",
        "tagKeys": "pod",
        "titleFormat": "Pod Restart"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Scanner — mysql-connector-be-go",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Pods Up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*mysql-connector-be-go\", namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connections (Open)",
      "description": "Open MySQL connections summed across every active scanner pool. Pools are per-datasource and created/evicted at runtime, so this is a scrape-time aggregate, not a fixed ceiling.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mysql_scanner_connections_open{namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ScanStart In Flight",
      "description": "ScanStart handler invocations currently doing database discovery and DatabaseFork fan-out. The per-table leaf work that runs after fan-out is counted separately (see Tables In Flight on the pipeline dashboard).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mysql_scanner_scanstart_in_flight{namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Items Sent (5m)",
      "description": "Items successfully submitted through ItemBatchSender.UpsertItem, per second.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mysql_scanner_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Scan p95 (5m)",
      "description": "p95 of the ScanStart discovery + fan-out phase. Histogram ladder is 0.5s to ~1024s, so this measures how long it takes to enumerate databases and hand out work — not how long a whole scan takes end to end.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mysql_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Error Rate (5m)",
      "description": "Query failures against the source database, per second: database_errors_total + table_errors_total. Skipped tables and connector bugs are counted apart — see the Silent-Failure Signals row.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mysql_scanner_database_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m])) + sum(rate(mysql_scanner_table_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Throughput & Errors (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mysql_scanner_items_sent_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "items sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mysql_scanner_tables_scanned_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "tables scanned"
        },
        {
          "refId": "C",
          "expr": "sum(rate(mysql_scanner_columns_found_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "columns found"
        },
        {
          "refId": "D",
          "expr": "sum(rate(mysql_scanner_database_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "database errors"
        },
        {
          "refId": "E",
          "expr": "sum(rate(mysql_scanner_table_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "table errors"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scan Duration — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mysql_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mysql_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mysql_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "row",
      "id": 150,
      "title": "Scanner — Silent-Failure Signals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "panels": []
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Table Panics (5m)",
      "description": "Leaf-worker tasks that panicked. Always a connector bug, never a source-database fault — counted apart from table_errors_total so a panic on an unexpected column shape doesn't read as the customer's MySQL refusing a query. Any non-zero value is worth acting on.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_scanner_table_panics_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Inline Fallback (5m)",
      "description": "Tables the worker pool refused, run inline on the NATS consumer goroutine instead of being dropped. The pool only refuses after Shutdown, so non-zero means a scan was still fanning out while the process was tearing down — accounting stays exact, but the rest of that database serialises onto one goroutine.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_scanner_table_inline_fallback_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "No Visible Columns (5m)",
      "description": "Tables skipped because INFORMATION_SCHEMA.COLUMNS returned no rows — a missing column-level GRANT, or a table dropped mid-scan. The query succeeded, so this is not a query failure. Alert on a sustained rate, not on any non-zero value.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_scanner_tables_no_visible_columns_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Error Reports Dropped (5m)",
      "description": "Structured errors that never reached the observer, across all reasons (buffer_full, after_close, publish_failed). Non-zero means the job record is showing a truncated view of the scan's failures. Break down by reason on the pipeline dashboard.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_scanner_error_reporter_dropped_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "Content — mysql-connector-be-go-content",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Pods Up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*mysql-connector-be-go-content\", namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Connections (Open)",
      "description": "Open MySQL connections summed across active content-fetch pools. A climb that does not come back down alongside a non-zero Conn Discard failure is the pool-exhaustion signature described on that panel.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mysql_content_connections_open{namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Fetch In Flight",
      "description": "Content fetch requests currently being processed.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mysql_content_fetch_in_flight{namespace=\"$namespace\", pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Fetches (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mysql_content_requests_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Fetch p95 (5m)",
      "description": "p95 end-to-end fetch latency for successful requests only: handler entry (URN parse, datasource resolve, conn acquire) through stream completion and reply publish. Errors are filtered out so a fast failure doesn't flatter the number.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mysql_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\", outcome=\"success\"}[5m])))"
        }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Errors (5m)",
      "description": "Content requests that errored in the last 5 minutes — counter increase on mysql_content_requests_total{outcome=\"error\"}.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_content_requests_total{namespace=\"$namespace\", pod=~\"$pod\", outcome=\"error\"}[5m]))"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Content Requests by Outcome (rate, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(mysql_content_requests_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Content Fetch Duration — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mysql_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mysql_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mysql_content_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "row",
      "id": 250,
      "title": "Content — Silent-Failure Signals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "panels": []
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Producer Panics (5m)",
      "description": "Streaming producers that panicked and were recovered. Always a connector bug: the requester is told INTERNAL/retryable and the message is redelivered, so nothing in the request's own outcome says this connector crashed.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_content_producer_panics_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Byte Mismatch (5m)",
      "description": "Uploads whose stored size disagreed with the sampled/streamed byte count. The handler NAKs without replying, so a single count is a transient that a redelivery repaired; a sustained rate means the same URN fails verification every attempt, and once MaxDeliver is spent the object proven wrong stays under that URN with no reply ever sent.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_content_byte_mismatch_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Conn Discard Failures (5m)",
      "description": "Abandoned result sets whose connection could NOT be discarded (outcome != \"discarded\"). The discard is the only defence against the driver's uncancellable drain of the rest of a multi-GB column — a drain that ignores the query deadline and SIGTERM while holding a pool connection and a worker slot. Non-zero means the byte budget stops bounding what crosses the wire, and the symptom surfaces as pool exhaustion rather than an error.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_content_conn_discard_total{namespace=\"$namespace\", pod=~\"$pod\", outcome!=\"discarded\"}[5m]))"
        }
      ]
    },
    {
      "id": 35,
      "type": "stat",
      "title": "Sample Re-draws (5m)",
      "description": "Content fetches whose first random draw fell under MYSQL_CONTENT_SAMPLE_MIN_ROWS and were re-drawn at a higher percent, all outcomes summed. Each re-draw is an extra table scan, so a sustained rate means MYSQL_CONTENT_SAMPLE_PERCENT is set too low for the tables being classified — raise the percent, not the floor. Break down by outcome on the pipeline dashboard: \"failed\" is a different problem and points at the query timeout and the source database.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mysql_content_sample_resample_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))"
        }
      ]
    }
  ]
