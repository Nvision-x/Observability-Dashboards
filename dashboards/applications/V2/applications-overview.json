      "fieldConfig": {
        "defaults": {
          "unit": "ops", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(cifs_scanner_acl_errors_total{namespace=\"$namespace\"}[5m])) + sum(rate(cifs_scanner_worker_connect_errors_total{namespace=\"$namespace\"}[5m]))" }
      ]
    },
    {
      "type": "row",
      "id": 400,
      "title": "CIFS — Content",
      "collapsed": false,
