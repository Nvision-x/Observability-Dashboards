      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*snowflake-connector-be-go-content\", namespace=\"$namespace\"})"
