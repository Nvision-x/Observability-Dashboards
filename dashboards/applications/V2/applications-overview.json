    {
      "id": 26,
      "type": "stat",
      "title": "Ingested (rate)",
      "description": "outcome=\"forwarded\" only — the one outcome that means a document was actually ingested.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(knowledge_service_pipeline_documents_processed_total{job=~\".*knowledge-service-be-go.*\", namespace=\"$namespace\", outcome=\"forwarded\"}[5m]))" }
      ]
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Processing p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
