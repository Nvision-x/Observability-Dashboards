            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]},
          "links": [{
            "title": "Open CIFS Overview",
            "url": "/d/apps-v2-cifs-overview?${namespace:queryparam}"
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
