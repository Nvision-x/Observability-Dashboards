            { "color": "green", "value": 1 }
          ]},
          "links": [{
            "title": "Open Request Service Overview",
            "url": "/d/apps-v2-request-service-overview?${namespace:queryparam}"
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=~\".*request-service.*\", namespace=\"$namespace\"})" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Tests Created (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 3 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(request_service_connectiontest_requests_total{job=~\".*request-service.*\", namespace=\"$namespace\", outcome=\"created\"}[5m]))" }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Round-Trip p95",
      "description": "Job creation through result consumed from NATS, on the service's own 0.1s-300s ladder — a different scale from the HTTP/gRPC latency histograms because a connection test is dispatched asynchronously and can run for minutes. Only counts round trips that completed: a result that never arrives shows up as a drop in observation count, not a latency spike.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(request_service_connectiontest_duration_seconds_bucket{job=~\".*request-service.*\", namespace=\"$namespace\"}[5m])))" }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Error Rate",
      "description": "Connection-test creations that failed, per second. This is a dispatch-side failure; a test that dispatches fine but never comes back shows up as stalled on the request-service overview, not here.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(request_service_connectiontest_requests_total{job=~\".*request-service.*\", namespace=\"$namespace\", outcome=\"error\"}[5m]))" }
      ]
    },
    {
      "type": "row",
      "id": 700,
      "title": "Knowledge Service",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "panels": []
    },
