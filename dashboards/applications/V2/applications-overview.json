{
  "uid": "apps-v2-overview",
  "title": "Applications V2 — Overview",
  "tags": ["git-sync", "apps-v2", "overview"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "folderUid": "applications-v2-folder",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus-nx" },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=~\".*-connector-be-go.*\"}, namespace)",
        "current": { "selected": false, "text": "default", "value": "default" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Snowflake",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Scanner Pods",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]},
          "links": [{
            "title": "Open Snowflake Overview",
            "url": "/d/apps-v2-snowflake-overview?${namespace:queryparam}"
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"snowflake-connector-be-go\", namespace=\"$namespace\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Content Pods",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]},
          "links": [{
            "title": "Open Snowflake Overview",
            "url": "/d/apps-v2-snowflake-overview?${namespace:queryparam}"
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"snowflake-connector-be-go-content\", namespace=\"$namespace\"})" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Items Sent (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_items_sent_total{namespace=\"$namespace\"}[5m]))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scan p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(snowflake_connector_scan_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error Rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snowflake_connector_database_errors_total{namespace=\"$namespace\"}[5m])) + sum(rate(snowflake_connector_table_errors_total{namespace=\"$namespace\"}[5m]))" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Pools",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sum(snowflake_connector_content_pools_active{namespace=\"$namespace\"})" }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "CIFS  (dashboards pending)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": [
        {
          "id": 201,
          "type": "stat",
          "title": "Pods Up",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 0, "y": 6 },
          "fieldConfig": { "defaults": { "unit": "short" } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(up{job=~\"cifs-connector-be-go.*\", namespace=\"$namespace\"})" }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": 300,
      "title": "PostgreSQL",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "panels": [
        {
          "id": 301,
          "type": "stat",
          "title": "Scanner Pods",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 0, "y": 7 },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]},
              "links": [{
                "title": "Open PostgreSQL Overview",
                "url": "/d/apps-v2-postgresql-overview?${namespace:queryparam}"
              }]
            }
          },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(up{job=\"postgresql-connector-be-go\", namespace=\"$namespace\"})" }
          ]
        },
        {
          "id": 302,
          "type": "stat",
          "title": "Content Pods",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 4, "y": 7 },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]},
              "links": [{
                "title": "Open PostgreSQL Overview",
                "url": "/d/apps-v2-postgresql-overview?${namespace:queryparam}"
              }]
            }
          },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(up{job=\"postgresql-connector-be-go-content\", namespace=\"$namespace\"})" }
          ]
        },
        {
          "id": 303,
          "type": "stat",
          "title": "Items Sent (rate)",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 8, "y": 7 },
          "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
          "targets": [
            { "refId": "A", "expr": "sum(rate(postgresql_scanner_items_sent_total{namespace=\"$namespace\"}[5m]))" }
          ]
        },
        {
          "id": 304,
          "type": "stat",
          "title": "Scan p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 12, "y": 7 },
          "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
          "targets": [
            { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(postgresql_scanner_scan_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))" }
          ]
        },
        {
          "id": 305,
          "type": "stat",
          "title": "Error Rate",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 16, "y": 7 },
          "fieldConfig": {
            "defaults": {
              "unit": "ops", "decimals": 3,
              "thresholds": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.1 }
              ]}
            }
          },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(rate(postgresql_scanner_database_errors_total{namespace=\"$namespace\"}[5m])) + sum(rate(postgresql_scanner_table_errors_total{namespace=\"$namespace\"}[5m]))" }
          ]
        },
        {
          "id": 306,
          "type": "stat",
          "title": "Content In Flight",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 20, "y": 7 },
          "fieldConfig": { "defaults": { "unit": "short" } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
          "targets": [
            { "refId": "A", "expr": "sum(postgresql_content_fetch_in_flight{namespace=\"$namespace\"})" }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": 400,
      "title": "Box  (dashboards pending)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "panels": [
        {
          "id": 401,
          "type": "stat",
          "title": "Pods Up",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
          "fieldConfig": { "defaults": { "unit": "short" } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(up{job=~\"box-connector-be-go.*\", namespace=\"$namespace\"})" }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": 500,
      "title": "SharePoint  (dashboards pending)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "panels": [
        {
          "id": 501,
          "type": "stat",
          "title": "Pods Up",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 0, "y": 9 },
          "fieldConfig": { "defaults": { "unit": "short" } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(up{job=~\"sharepoint-connector-be-go.*\", namespace=\"$namespace\"})" }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": 600,
      "title": "NFS  (no app metrics yet — instrument first)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": [
        {
          "id": 601,
          "type": "stat",
          "title": "Pods Up",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 4, "x": 0, "y": 10 },
          "fieldConfig": { "defaults": { "unit": "short" } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
          "targets": [
            { "refId": "A", "expr": "sum(up{job=~\"nfs-connector-be-go.*\", namespace=\"$namespace\"})" }
          ]
        }
      ]
    }
  ]
}
