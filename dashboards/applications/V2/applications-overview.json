            { "color": "green", "value": 1 }
          ]},
          "links": [{
            "title": "Open Registration Service Overview",
            "url": "/d/apps-v2-registration-service-overview?${namespace:queryparam}"
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=~\".*registration-service.*\", namespace=\"$namespace\"})" }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Registrations (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
