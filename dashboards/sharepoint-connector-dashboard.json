      "title": "Fetch errors by code",
      "description": "FetchErrorCode as classified by classifyGraphError (internal/fetch/handler.go:339).\n\nRETRYABLE (these are the dangerous ones \u2014 content-service will retry each 15x): RATE_LIMITED, CONNECTION_FAILED, TIMEOUT, READ_ERROR, CACHE_WRITE_FAILED\nNON-RETRYABLE (cheap, fail once): NOT_FOUND, PERMISSION_DENIED, INVALID_URN, TOO_LARGE, INTERNAL(4xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (code) (rate(sharepoint_content_fetch_error_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{code}}",
          "range": true,
          "editorMode": "code"
        }
