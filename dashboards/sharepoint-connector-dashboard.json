{
  "uid": "nx-sharepoint-connector",
  "title": "SharePoint Connector \u2014 Graph Fetch, Throttling & Leak Detection",
  "description": "Built 2026-07-30 for NXE-2480. Covers the sharepoint_* and graph_* metric families, which no earlier dashboard touched. Read the reference panel at the bottom first \u2014 there is no 429 counter and a flat 5xx graph is misleading.",
  "tags": [
    "nvision-x",
    "sharepoint",
    "connector",
    "graph",
    "nxe-2480",
    "git-sync"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sharepoint_content_fetch_success_total, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sharepoint_content_fetch_success_total{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "code",
        "label": "Error code",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sharepoint_content_fetch_error_total, code)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "client_id",
        "label": "Graph app registration",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(graph_client_inflight, client_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "THROTTLING \u2014 is Microsoft rate-limiting us?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Graph 429 rate (RATE_LIMITED)",
      "description": "Non-zero here means Microsoft Graph is throttling our app registration. This is the metric the whole NXE-2480 hypothesis turns on.\n\nNOTE: if the connector cannot read the HTTP status it falls through to CONNECTION_FAILED instead, so check the breakdown panel too rather than reading a zero here as proof.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(sharepoint_content_fetch_error_total{namespace=~\"$namespace\", pod=~\"$pod\", code=\"FETCH_ERROR_RATE_LIMITED\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
