    {
      "type": "timeseries",
      "title": "Graph client in-flight by app registration",
      "description": "SHAPE MATTERS MORE THAN VALUE.\n\nsawtooth returning to 0 between scans -> healthy\nmonotonic ratchet never returning to 0 -> the Redis in-flight counter is leaking, and the connector will start blocking on every fetch once all clients exceed maxInflight\n\nSee the panel to the right for the two-minute test that settles it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (client_id) (graph_client_inflight)",
          "legendFormat": "{{client_id}}",
          "range": true,
          "editorMode": "code"
        }
