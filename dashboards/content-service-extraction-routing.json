          "legendFormat": "{{parser_kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Time in the extractor itself, per backend.\n\nDo not read tika and tika_routed as the same workload: tika is a background sample of a document xberg also parsed, tika_routed is a foreground parse that is the only one that ran. They were deliberately given different label values so these lines stay separable.\n\nSuccesses only, matching the Tika vs Kreuzberg dashboard: a timed-out extraction would otherwise enter the quantile as its own timeout value and flatten the real distribution.",
      "id": 10,
      "title": "p95 extraction latency by parser_kind",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, parser_kind) (rate(content_extraction_duration_seconds_bucket{namespace=\"$namespace\", job=\"$job\", status=\"success\"}[5m])))",
          "legendFormat": "p95 \u2014 {{parser_kind}}",
          "refId": "A"
        }
      ]
    },
