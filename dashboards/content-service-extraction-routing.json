      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(content_extraction_total{namespace=\"$namespace\", job=\"$job\", parser_kind=~\"spreadsheet|tika_routed\"}[5m]))\n  /\nsum (rate(content_extraction_total{namespace=\"$namespace\", job=\"$job\", parser_kind!=\"tika\"}[5m]))",
          "legendFormat": "routed share",
          "refId": "A"
        }
      ]
    },
    {
