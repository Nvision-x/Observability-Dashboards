          },
          "expr": "sum(rate(elasticsearch_indices_search_query_total[5m]))",
          "legendFormat": "queries/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OS CPU % by node",
      "id": 16,
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
