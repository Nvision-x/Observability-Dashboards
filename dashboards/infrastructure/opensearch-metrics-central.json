          },
          "expr": "sum(rate(elasticsearch_indices_indexing_index_total[5m]))",
          "legendFormat": "indexed/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Search rate",
      "id": 15,
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
