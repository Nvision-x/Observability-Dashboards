      "id": 1,
      "options": {
        "content": "Fleet-wide status across every application-layer service in this cluster. Each panel below breaks down **by service** (the Prometheus `job` label), not a single combined number — use it to spot which specific service is unhealthy, not just that \"something\" is.",
        "mode": "markdown"
      },
      "targets": [],
      "title": "NVisionX — Application Health (Executive View)",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
